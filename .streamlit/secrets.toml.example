# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and add your actual values
# NEVER commit .streamlit/secrets.toml to git (it's already in .gitignore)

# ==============================================================================
# CURRENT CONFIGURATION (Yahoo Finance - No Keys Required)
# ==============================================================================
# Yahoo Finance (yfinance) is a FREE library that doesn't require API keys.
# The current app works without any secrets configuration.

# ==============================================================================
# FUTURE EXTENSIBILITY (Premium Data Providers)
# ==============================================================================
# If you want to add premium data providers in the future, add them below:

# Example: Alpha Vantage API (uncomment and add your key)
# [alphavantage]
# api_key = "YOUR_ALPHA_VANTAGE_API_KEY_HERE"

# Example: Polygon.io API (uncomment and add your key)
# [polygon]
# api_key = "YOUR_POLYGON_API_KEY_HERE"

# Example: Finnhub API (uncomment and add your key)
# [finnhub]
# api_key = "YOUR_FINNHUB_API_KEY_HERE"

# Example: IEX Cloud API (uncomment and add your key)
# [iexcloud]
# api_key = "YOUR_IEX_CLOUD_API_KEY_HERE"
# secret_key = "YOUR_IEX_CLOUD_SECRET_KEY_HERE"

# ==============================================================================
# DEPLOYMENT CONFIGURATION
# ==============================================================================

# For Streamlit Community Cloud:
# 1. Go to your app settings
# 2. Click "Secrets"
# 3. Add secrets in TOML format (same as this file)
# 4. The app will automatically use st.secrets to access them

# For local development:
# 1. Copy this file to .streamlit/secrets.toml
# 2. Add your actual API keys
# 3. The file is already in .gitignore and won't be committed

# For environment variables (alternative to secrets.toml):
# Set environment variables in your terminal:
# export ALPHAVANTAGE_API_KEY="your_key_here"
# The get_config() function will automatically use them

# ==============================================================================
# SECURITY BEST PRACTICES
# ==============================================================================
# ✅ DO: Use secrets.toml or environment variables
# ✅ DO: Keep secrets.toml in .gitignore
# ✅ DO: Use different keys for development and production
# ✅ DO: Rotate API keys regularly
# ✅ DO: Use Streamlit Cloud secrets for deployed apps
#
# ❌ DON'T: Hardcode API keys in source code
# ❌ DON'T: Commit secrets.toml to git
# ❌ DON'T: Share API keys in public channels
# ❌ DON'T: Use production keys in development
